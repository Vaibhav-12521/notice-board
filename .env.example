# Supabase (Postgres) connection strings.
# Copy this file to ".env" and paste your OWN values from the Supabase dashboard:
#   Connect -> ORMs -> Prisma.
#
# DO NOT put real credentials in this file — it is committed to the repo.
# Real secrets go in ".env" (which is gitignored).
#
# NOTE: if your password contains special characters (@ : / ? # etc.),
# URL-encode them. For example "@" becomes "%40".
#
# DATABASE_URL = pooled connection (port 6543, pgbouncer) used by the app at runtime.
# DIRECT_URL   = direct connection (port 5432) used by Prisma for migrations / db push.

DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"
